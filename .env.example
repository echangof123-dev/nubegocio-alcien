# Copia este archivo como .env para desarrollo local. En producción, los secretos van en Secret Manager.

ALCIEN_ENTORNO=desarrollo            # desarrollo | pruebas | produccion
PORT=8080

# Base de datos (usuario sin privilegios creado con db/scripts/crear_usuario_api.sh)
PGHOST=127.0.0.1                     # en Cloud Run con Cloud SQL: /cloudsql/PROYECTO:REGION:INSTANCIA
PGPORT=5432
PGUSER=alcien_api
PGPASSWORD=alcien-dev
PGDATABASE=alcien_dev
PGSSL=false
PGPOOL_MAX=10

# Firma de los códigos de acceso: 32+ caracteres aleatorios en producción
ALCIEN_SECRETO_CODIGOS=

# Orígenes extra que pueden hacer peticiones (separados por coma)
ALCIEN_ORIGENES=

# WhatsApp Cloud API (en desarrollo se usa "consola" y el código aparece en pantalla)
WHATSAPP_PROVEEDOR=consola           # consola | meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PLANTILLA_CODIGO=codigo_acceso
WHATSAPP_API_VERSION=v21.0

# IA para tipos de negocio nuevos (opcional: sin clave se usa la familia general)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# App web compilada (la API la sirve)
ALCIEN_WEB_DIR=apps/web/dist

# Facturación electrónica SRI
# Clave para cifrar las firmas .p12 de los negocios: openssl rand -base64 32 (obligatoria en producción)
ALCIEN_CLAVE_FIRMAS=
# Token de la tarea programada que reintenta envíos al SRI (POST /api/tareas/sri, 32+ caracteres)
ALCIEN_TOKEN_TAREAS=
# Reintentos dentro del servicio cada N segundos (0 = solo la tarea programada)
SRI_INTERVALO_SEG=60
# Solo para pruebas locales con el SRI de mentira (node e2e/sri-falso.mjs)
# SRI_URL_PRUEBAS=http://127.0.0.1:9099/ws
